<?xml version="1.0" encoding="utf-8"?>
<!--
  Audit DI-14 / DI-17. Secrets (cloud tokens, licence and purchase state, Keystore-bound keys, the settings DataStore
  that holds the AI key, the signing certificate), the full-text index of document text and the origin URI map never
  leave the device. Cloud backup also skips the bulky, re-creatable or user-document folders so it stays under the
  25 MB quota (otherwise Android backs up nothing). Device-to-device transfer keeps the documents.
  Keep this list in sync with backup_rules.xml (Android 11 and lower); BackupRulesTest checks both.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="cloud_drive.xml" />
    <exclude domain="sharedpref" path="cloud_onedrive.xml" />
    <exclude domain="sharedpref" path="cloud_dropbox.xml" />
    <exclude domain="sharedpref" path="cloud_box.xml" />
    <exclude domain="sharedpref" path="oauth_pending.xml" />
    <exclude domain="sharedpref" path="license_state.xml" />
    <exclude domain="sharedpref" path="pro_entitlement.xml" />
    <exclude domain="sharedpref" path="connected_keys.xml" />
    <exclude domain="sharedpref" path="esign_store.xml" />
    <exclude domain="sharedpref" path="origins.xml" />
    <exclude domain="file" path="datastore/settings.preferences_pb" />
    <exclude domain="database" path="search_index.db" />
    <exclude domain="file" path="own_certificate.p12" />
    <exclude domain="external" path="Documents/" />
    <exclude domain="file" path="tessdata/" />
    <exclude domain="file" path="ocr_best/" />
    <exclude domain="file" path="trash/" />
</full-backup-content>

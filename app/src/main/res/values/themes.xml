<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartDocs" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F8F9FE</item>
        <item name="android:colorAccent">#1565C0</item>
        <item name="android:fontFamily">@font/noto_sans_arabic_regular</item>
    </style>
    <style name="Theme.SmartDocs.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1565C0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.SmartDocs</item>
    </style>
</resources>

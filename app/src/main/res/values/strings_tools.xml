    <!-- help / about -->
    <string name="tl_help_title">المساعدة وحول التطبيق</string>
    <string name="tl_help_intro">محرر PDF عربي متكامل يعمل دون اتصال: اقرأ، علّق، حرّر الصفحات، وقّع، حوّل، واحمِ ملفاتك من مكان واحد.</string>
    <string name="tl_help_features">المميزات</string>
    <string name="tl_help_read_t">قراءة مريحة</string>
    <string name="tl_help_read_b">تمرير متصل أو صفحة واحدة، وضع ليلي، بحث في النص، فهرس وإشارات مرجعية، وقراءة بصوت عالٍ.</string>
    <string name="tl_help_annotate_t">تعليق وتحرير</string>
    <string name="tl_help_annotate_b">تظليل، تسطير، ملاحظات، رسم بالقلم، أشكال، أختام، وإدراج نص وصور على الصفحات.</string>
    <string name="tl_help_pages_t">تنظيم الصفحات</string>
    <string name="tl_help_pages_b">دمج، تقسيم، تدوير، حذف، إعادة ترتيب، استخراج صفحات، ترقيم، علامة مائية، وتقليل الحجم.</string>
    <string name="tl_help_convert_t">تحويل</string>
    <string name="tl_help_convert_b">صور ونصوص وصفحات ويب إلى PDF، وPDF إلى صور وWord وHTML ونص.</string>
    <string name="tl_help_scan_t">مسح ضوئي وOCR</string>
    <string name="tl_help_scan_b">صوّر المستندات بالكاميرا مع قص تلقائي، وحوّل الصور الممسوحة إلى نص قابل للبحث بالعربية والإنجليزية.</string>
    <string name="tl_help_secure_t">حماية وتوقيع</string>
    <string name="tl_help_secure_b">كلمات مرور وصلاحيات، إزالة الحماية، تنقيح نهائي، تسطيح، وتوقيع يدوي أو رقمي بشهادة.</string>
    <string name="tl_help_forms_t">النماذج</string>
    <string name="tl_help_forms_b">تعبئة حقول النماذج، حفظ بياناتك لتعبئتها بسرعة، وتصدير البيانات.</string>
    <string name="tl_help_ai_t">المساعد الذكي</string>
    <string name="tl_help_ai_b">تلخيص، شرح، ترجمة، وأسئلة مراجعة عن المستند عبر مفتاح API الخاص بك.</string>
    <string name="tl_help_wifi_t">النقل عبر الشبكة</string>
    <string name="tl_help_wifi_b">انقل الملفات بين الهاتف والكمبيوتر عبر المتصفح على نفس شبكة Wi-Fi دون كابل.</string>
    <string name="tl_help_privacy">تُعالج جميع الملفات على جهازك ولا تُرسل إلى أي خادم، باستثناء ميزات المساعد الذكي وتحويل صفحات الويب التي تحتاج إلى الإنترنت.</string>
